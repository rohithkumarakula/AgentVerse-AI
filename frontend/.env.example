# AgentVerse AI — frontend environment
#
# Base URL of the FastAPI backend, with no trailing slash.
# The app falls back to http://localhost:8000 when this is unset,
# so local development works without a .env file.
#
# On Vercel, set this in Project Settings → Environment Variables
# to the deployed backend URL, e.g.
#   VITE_API_URL=https://your-backend.onrender.com
#
# Only VITE_-prefixed values reach the browser. Never put
# GROQ_API_KEY or any other secret in this file — it belongs in
# the backend environment only.

VITE_API_URL=http://localhost:8000
